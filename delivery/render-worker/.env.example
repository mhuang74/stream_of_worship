# Stream of Worship - Render Worker - Environment Configuration
# Copy this file to .env and configure for your environment
# These variable names match the shared /opt/sow/.env used by all SOW services

# Database connection — Neon PostgreSQL connection string
SOW_DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Cloudflare R2 (S3-compatible) storage configuration
# NOTE: R2 credentials are also used at Docker build time (via build args)
# to download FFmpeg from R2. See "Build Args" in README.md for details.
SOW_R2_BUCKET=your-r2-bucket-name
SOW_R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
SOW_R2_ACCESS_KEY_ID=your-r2-access-key-id
SOW_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# AWS region for SQS and Lambda
SOW_AWS_REGION=us-west-2

# SQS queue URL for render job messages
SOW_SQS_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/123456789012/sow-render-jobs

# SQS queue URL for Glue (AI transition) job messages.
# Separate queue from the render queue above: never point this at
# SOW_SQS_QUEUE_URL. Created by deploy/aws-up-glue.sh (sow-glue-jobs).
SOW_GLUE_SQS_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/123456789012/sow-glue-jobs

# The webapp signs its Glue sends with SOW_GLUE_AWS_REGION (falling back to
# SOW_AWS_REGION); that value must name the same region as the URL above.
# This worker ignores it — it only consumes from the queue.

# ElevenLabs provider key for paid Glue stages — WORKER/SERVER ONLY.
# NEVER prefix this with NEXT_PUBLIC_ and never expose it to browser code.
# Leave unset to keep Glue generation disabled: a missing key fails with
# GLUE_NOT_CONFIGURED before any paid reservation or spend. The key is set on
# the Glue Lambda function only, never on the render worker.
SOW_ELEVENLABS_API_KEY=
